//@version=6
strategy(
     title="NQ Institutional Liquidity Strategy",
     shorttitle="NQ ILS",
     overlay=true,
     pyramiding=0,
     initial_capital=50000,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=2.50,
     calc_on_every_tick=true,
     calc_on_order_fills=true,
     process_orders_on_close=false,
     max_labels_count=500,
     max_lines_count=500,
     max_boxes_count=500)

//=========================================================
// VERSION
//=========================================================

const string VERSION = "0.1.0"

//=========================================================
// INPUT GROUPS
//=========================================================

string gSession = "Sessions"
string gHTF     = "Higher Time Frames"
string gRisk    = "Risk"
string gVisual  = "Visual"
string gFilter  = "Filters"

//=========================================================
// SESSION INPUTS
//=========================================================

showAsia   = input.bool(true, "Show Asia", group=gSession)
showLondon = input.bool(true, "Show London", group=gSession)
showNY     = input.bool(true, "Show New York", group=gSession)

asiaSession   = input.session("1700-0000", "Asia Session", group=gSession)
londonSession = input.session("0200-0500", "London Session", group=gSession)
nySession     = input.session("0830-1100", "New York Session", group=gSession)

//=========================================================
// MULTI TIMEFRAME
//=========================================================

executionTF = input.timeframe("1", "Execution TF", group=gHTF)
swingTF     = input.timeframe("5", "Swing TF", group=gHTF)
biasTF      = input.timeframe("15", "Bias TF", group=gHTF)
dailyTF     = input.timeframe("D", "Daily Liquidity", group=gHTF)

//=========================================================
// RISK
//=========================================================

riskPercent = input.float(1.0, "Risk %", step=.25, group=gRisk)

atrLength = input.int(14, "ATR Length", group=gRisk)
atrMult   = input.float(2.0, "ATR Stop", step=.25, group=gRisk)

//=========================================================
// FILTERS
//=========================================================

emaLength = input.int(50, "EMA Length", group=gFilter)

useEMA = input.bool(true, "Use EMA Filter", group=gFilter)

//=========================================================
// VISUAL
//=========================================================

showDashboard = input.bool(true, "Dashboard", group=gVisual)
showLevels    = input.bool(true, "Liquidity Levels", group=gVisual)
showSignals   = input.bool(true, "Signals", group=gVisual)

//=========================================================
// ENUMS
//=========================================================

enum Bias
    Bullish
    Bearish
    Neutral

enum TradeState
    Waiting
    LiquidityFound
    Swept
    Displacement
    MSS
    FVG
    Retracement
    Entered
    Managing

enum LiquidityType
    PDH
    PDL
    PWH
    PWL
    AsiaHigh
    AsiaLow
    LondonHigh
    LondonLow
    NYHigh
    NYLow
    SwingHigh
    SwingLow
    EqualHigh
    EqualLow

//=========================================================
// GLOBAL STATE
//=========================================================

var TradeState state = TradeState.Waiting
var Bias bias = Bias.Neutral

//=========================================================
// CORE CALCULATIONS
//=========================================================

ema = ta.ema(close, emaLength)
atr = ta.atr(atrLength)

bullTrend = close > ema
bearTrend = close < ema

plot(useEMA ? ema : na, title="EMA", color=color.orange, linewidth=2)

//=========================================================
// SESSION STATUS
//=========================================================

inAsia   = not na(time(timeframe.period, asiaSession))
inLondon = not na(time(timeframe.period, londonSession))
inNY     = not na(time(timeframe.period, nySession))

if showAsia and inAsia
    bgcolor(color.new(color.blue,92))

if showLondon and inLondon
    bgcolor(color.new(color.yellow,92))

if showNY and inNY
    bgcolor(color.new(color.green,92))

//=========================================================
// HIGHER TIMEFRAME DATA
//=========================================================

biasClose =
    request.security(
        syminfo.tickerid,
        biasTF,
        close,
        lookahead=barmerge.lookahead_off)

biasEMA =
    request.security(
        syminfo.tickerid,
        biasTF,
        ta.ema(close,50),
        lookahead=barmerge.lookahead_off)

bias :=
     biasClose > biasEMA ? Bias.Bullish :
     biasClose < biasEMA ? Bias.Bearish :
     Bias.Neutral

//=========================================================
// PREVIOUS DAY LIQUIDITY
//=========================================================

previousDayHigh =
    request.security(
        syminfo.tickerid,
        dailyTF,
        high[1],
        lookahead=barmerge.lookahead_off)

previousDayLow =
    request.security(
        syminfo.tickerid,
        dailyTF,
        low[1],
        lookahead=barmerge.lookahead_off)

plot(showLevels ? previousDayHigh : na,
     "PDH",
     color=color.lime,
     linewidth=2)

plot(showLevels ? previousDayLow : na,
     "PDL",
     color=color.red,
     linewidth=2)
//=========================================================
// LIQUIDITY ENGINE
// MODULE 02A
//=========================================================

//-------------------------
// Session Start Detection
//-------------------------

asiaStart   = inAsia and not inAsia[1]
londonStart = inLondon and not inLondon[1]
nyStart     = inNY and not inNY[1]

//-------------------------
// Session Variables
//-------------------------

var float asiaHigh = na
var float asiaLow  = na

var float londonHigh = na
var float londonLow  = na

var float nyHigh = na
var float nyLow  = na

//-------------------------
// Reset Session Ranges
//-------------------------

if asiaStart
    asiaHigh := high
    asiaLow := low

if londonStart
    londonHigh := high
    londonLow := low

if nyStart
    nyHigh := high
    nyLow := low

//-------------------------
// Track Session High/Low
//-------------------------

if inAsia
    asiaHigh := math.max(nz(asiaHigh, high), high)
    asiaLow := math.min(nz(asiaLow, low), low)

if inLondon
    londonHigh := math.max(nz(londonHigh, high), high)
    londonLow := math.min(nz(londonLow, low), low)

if inNY
    nyHigh := math.max(nz(nyHigh, high), high)
    nyLow := math.min(nz(nyLow, low), low)

//-------------------------
// Plot Liquidity
//-------------------------

plot(showLevels ? asiaHigh : na,
     "Asia High",
     color=color.aqua,
     linewidth=2)

plot(showLevels ? asiaLow : na,
     "Asia Low",
     color=color.aqua,
     linewidth=2)

plot(showLevels ? londonHigh : na,
     "London High",
     color=color.orange,
     linewidth=2)

plot(showLevels ? londonLow : na,
     "London Low",
     color=color.orange,
     linewidth=2)

plot(showLevels ? nyHigh : na,
     "NY High",
     color=color.green,
     linewidth=2)

plot(showLevels ? nyLow : na,
     "NY Low",
     color=color.green,
     linewidth=2)
//=========================================================
// MODULE 02B
// SWING LIQUIDITY ENGINE
//=========================================================

// ---------- User Inputs ----------

swingLength = input.int(5, "Swing Length", minval=2, maxval=20, group="Liquidity")

equalTickTolerance = input.float(
     2.0,
     "Equal High/Low Tick Tolerance",
     step=0.25,
     group="Liquidity")

// ---------- Swing Detection ----------

pivotHigh = ta.pivothigh(high, swingLength, swingLength)
pivotLow  = ta.pivotlow(low, swingLength, swingLength)

var float lastSwingHigh = na
var float lastSwingLow  = na

var int lastSwingHighBar = na
var int lastSwingLowBar = na

if not na(pivotHigh)
    lastSwingHigh := pivotHigh
    lastSwingHighBar := bar_index - swingLength

if not na(pivotLow)
    lastSwingLow := pivotLow
    lastSwingLowBar := bar_index - swingLength

// ---------- Plot Swings ----------

plot(
     showLevels ? lastSwingHigh : na,
     title="Last Swing High",
     color=color.fuchsia,
     linewidth=2,
     style=plot.style_linebr)

plot(
     showLevels ? lastSwingLow : na,
     title="Last Swing Low",
     color=color.fuchsia,
     linewidth=2,
     style=plot.style_linebr)

// ---------- Equal High / Low Detection ----------

tickSize = syminfo.mintick

equalTolerance = equalTickTolerance * tickSize

var float equalHigh = na
var float equalLow = na

if not na(lastSwingHigh) and not na(lastSwingHigh[1])
    if math.abs(lastSwingHigh - lastSwingHigh[1]) <= equalTolerance
        equalHigh := lastSwingHigh

if not na(lastSwingLow) and not na(lastSwingLow[1])
    if math.abs(lastSwingLow - lastSwingLow[1]) <= equalTolerance
        equalLow := lastSwingLow

plot(
     showLevels ? equalHigh : na,
     title="Equal High",
     color=color.red,
     linewidth=3)

plot(
     showLevels ? equalLow : na,
     title="Equal Low",
     color=color.lime,
     linewidth=3)

//=========================================================
// SWEEP DETECTION
//=========================================================

sweptPDH = high > previousDayHigh and close < previousDayHigh
sweptPDL = low < previousDayLow and close > previousDayLow

sweptAsiaHigh = not na(asiaHigh) and high > asiaHigh and close < asiaHigh
sweptAsiaLow  = not na(asiaLow) and low < asiaLow and close > asiaLow

sweptLondonHigh = not na(londonHigh) and high > londonHigh and close < londonHigh
sweptLondonLow  = not na(londonLow) and low < londonLow and close > londonLow

sweptNYHigh = not na(nyHigh) and high > nyHigh and close < nyHigh
sweptNYLow  = not na(nyLow) and low < nyLow and close > nyLow

sweptSwingHigh = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh
sweptSwingLow  = not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow

//=========================================================
// SWEEP SCORE
//=========================================================

bullSweepScore = 0
bearSweepScore = 0

bullSweepScore += sweptPDL ? 25 : 0
bullSweepScore += sweptAsiaLow ? 15 : 0
bullSweepScore += sweptLondonLow ? 15 : 0
bullSweepScore += sweptNYLow ? 10 : 0
bullSweepScore += sweptSwingLow ? 10 : 0

bearSweepScore += sweptPDH ? 25 : 0
bearSweepScore += sweptAsiaHigh ? 15 : 0
bearSweepScore += sweptLondonHigh ? 15 : 0
bearSweepScore += sweptNYHigh ? 10 : 0
bearSweepScore += sweptSwingHigh ? 10 : 0

//=========================================================
// VISUAL MARKERS
//=========================================================

plotshape(
     sweptPDH,
     title="PDH Sweep",
     style=shape.triangledown,
     location=location.abovebar,
     color=color.red,
     size=size.small)

plotshape(
     sweptPDL,
     title="PDL Sweep",
     style=shape.triangleup,
     location=location.belowbar,
     color=color.lime,
     size=size.small)

plotshape(
     sweptSwingHigh,
     title="Swing High Sweep",
     style=shape.circle,
     location=location.abovebar,
     color=color.red,
     size=size.tiny)

plotshape(
     sweptSwingLow,
     title="Swing Low Sweep",
     style=shape.circle,
     location=location.belowbar,
     color=color.lime,
     size=size.tiny)
//=========================================================
// MODULE 03A
// MARKET STRUCTURE ENGINE
//=========================================================

//---------------------------------------------------------
// Internal Structure (1 Minute)
//---------------------------------------------------------

internalLength = input.int(
     3,
     "Internal Swing Length",
     minval = 2,
     maxval = 10,
     group = "Structure")

internalHigh =
     ta.pivothigh(
         high,
         internalLength,
         internalLength)

internalLow =
     ta.pivotlow(
         low,
         internalLength,
         internalLength)

var float internalSwingHigh = na
var float internalSwingLow = na

if not na(internalHigh)
    internalSwingHigh := internalHigh

if not na(internalLow)
    internalSwingLow := internalLow

//---------------------------------------------------------
// Higher Structure (5 Minute)
//---------------------------------------------------------

htfSwingHigh =
    request.security(
        syminfo.tickerid,
        swingTF,
        ta.pivothigh(high,5,5),
        lookahead=barmerge.lookahead_off)

htfSwingLow =
    request.security(
        syminfo.tickerid,
        swingTF,
        ta.pivotlow(low,5,5),
        lookahead=barmerge.lookahead_off)

var float majorSwingHigh = na
var float majorSwingLow = na

if not na(htfSwingHigh)
    majorSwingHigh := htfSwingHigh

if not na(htfSwingLow)
    majorSwingLow := htfSwingLow

//---------------------------------------------------------
// Plot Structure
//---------------------------------------------------------

plot(
     showLevels ? majorSwingHigh : na,
     "Major Swing High",
     color=color.white,
     linewidth=2)

plot(
     showLevels ? majorSwingLow : na,
     "Major Swing Low",
     color=color.white,
     linewidth=2)
//=========================================================
// MODULE 03B
// BOS / MSS DETECTION
//=========================================================

bullBOS =
     not na(internalSwingHigh) and
     close > internalSwingHigh

bearBOS =
     not na(internalSwingLow) and
     close < internalSwingLow

bullMSS =
     sweptSwingLow and
     bullBOS

bearMSS =
     sweptSwingHigh and
     bearBOS

plotshape(
     bullMSS,
     title="Bull MSS",
     style=shape.labelup,
     text="MSS",
     location=location.belowbar,
     color=color.lime,
     textcolor=color.black)

plotshape(
     bearMSS,
     title="Bear MSS",
     style=shape.labeldown,
     text="MSS",
     location=location.abovebar,
     color=color.red,
     textcolor=color.white)
//=========================================================
// MODULE 03C
// DISPLACEMENT ENGINE
//=========================================================

groupDisplacement = "Displacement"

displacementATRMult =
    input.float(
        1.20,
        "Minimum ATR Multiple",
        step = 0.05,
        group = groupDisplacement)

bodyPercentRequired =
    input.float(
        65.0,
        "Minimum Body %",
        step = 5,
        group = groupDisplacement)

//---------------------------------------------------------
// Candle Measurements
//---------------------------------------------------------

candleRange = high - low

bodySize = math.abs(close - open)

bodyPercent =
    candleRange > 0
        ? bodySize / candleRange * 100
        : 0

bullBody = close > open
bearBody = close < open

//---------------------------------------------------------
// Displacement
//---------------------------------------------------------

bullDisplacement =
     bullBody and
     bodyPercent >= bodyPercentRequired and
     bodySize >= atr * displacementATRMult

bearDisplacement =
     bearBody and
     bodyPercent >= bodyPercentRequired and
     bodySize >= atr * displacementATRMult

//---------------------------------------------------------
// Plot
//---------------------------------------------------------

plotshape(
     bullDisplacement,
     title="Bull Displacement",
     style=shape.square,
     color=color.lime,
     location=location.belowbar,
     size=size.tiny)

plotshape(
     bearDisplacement,
     title="Bear Displacement",
     style=shape.square,
     color=color.red,
     location=location.abovebar,
     size=size.tiny)
bullMSS =
     sweptSwingLow and
     bullDisplacement and
     bullBOS

bearMSS =
     sweptSwingHigh and
     bearDisplacement and
     bearBOS
//=========================================================
// MODULE 03E
// STATE MACHINE
//=========================================================

if state == TradeState.Waiting

    if sweptSwingLow or sweptPDL or sweptAsiaLow or sweptLondonLow or sweptNYLow
        state := TradeState.Swept

    if sweptSwingHigh or sweptPDH or sweptAsiaHigh or sweptLondonHigh or sweptNYHigh
        state := TradeState.Swept

if state == TradeState.Swept

    if bullDisplacement or bearDisplacement
        state := TradeState.Displacement

if state == TradeState.Displacement

    if bullMSS or bearMSS
        state := TradeState.MSS
//=========================================================
// MODULE 04A
// FAIR VALUE GAP ENGINE
//=========================================================

groupFVG = "Fair Value Gaps"

enableFVG =
    input.bool(
        true,
        "Enable FVG Filter",
        group = groupFVG)

minimumGapTicks =
    input.int(
        8,
        "Minimum Gap (Ticks)",
        minval = 1,
        group = groupFVG)

tickValue = syminfo.mintick

minimumGap =
    minimumGapTicks * tickValue

//---------------------------------------------------------
// Bullish FVG
//---------------------------------------------------------

bullFVG =
     low > high[2] and
     (low - high[2]) >= minimumGap

bullFVGTop = low
bullFVGBottom = high[2]

//---------------------------------------------------------
// Bearish FVG
//---------------------------------------------------------

bearFVG =
     high < low[2] and
     (low[2] - high) >= minimumGap

bearFVGTop = low[2]
bearFVGBottom = high

//---------------------------------------------------------
// Draw FVG
//---------------------------------------------------------

var box bullBox = na
var box bearBox = na

if bullFVG
    bullBox := box.new(
         left = bar_index-2,
         top = bullFVGTop,
         right = bar_index+25,
         bottom = bullFVGBottom,
         bgcolor = color.new(color.lime,85),
         border_color = color.lime)

if bearFVG
    bearBox := box.new(
         left = bar_index-2,
         top = bearFVGTop,
         right = bar_index+25,
         bottom = bearFVGBottom,
         bgcolor = color.new(color.red,85),
         border_color = color.red)
//=========================================================
// FVG RETRACEMENT
//=========================================================

bullRetrace =
     bullFVG and
     low <= bullFVGTop and
     low >= bullFVGBottom

bearRetrace =
     bearFVG and
     high >= bearFVGBottom and
     high <= bearFVGTop

plotshape(
     bullRetrace,
     title="Bull FVG Retest",
     style=shape.diamond,
     color=color.lime,
     location=location.belowbar,
     size=size.small)

plotshape(
     bearRetrace,
     title="Bear FVG Retest",
     style=shape.diamond,
     color=color.red,
     location=location.abovebar,
     size=size.small)
//=========================================================
// ENTRY SCORE
//=========================================================

bullScore = 0
bearScore = 0

bullScore += sweptPDL ? 25 : 0
bullScore += sweptAsiaLow ? 15 : 0
bullScore += sweptLondonLow ? 15 : 0
bullScore += sweptNYLow ? 10 : 0

bullScore += bullDisplacement ? 20 : 0
bullScore += bullMSS ? 20 : 0
bullScore += bullFVG ? 15 : 0
bullScore += bias == Bias.Bullish ? 10 : 0

bearScore += sweptPDH ? 25 : 0
bearScore += sweptAsiaHigh ? 15 : 0
bearScore += sweptLondonHigh ? 15 : 0
bearScore += sweptNYHigh ? 10 : 0

bearScore += bearDisplacement ? 20 : 0
bearScore += bearMSS ? 20 : 0
bearScore += bearFVG ? 15 : 0
bearScore += bias == Bias.Bearish ? 10 : 0
