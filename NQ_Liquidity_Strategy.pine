//@version=6
strategy(
     title="NQ Institutional Liquidity Strategy",
     shorttitle="NQ ILS",
     overlay=true,
     pyramiding=0,
     initial_capital=50000,
     commission_type=strategy.commission.cash_per_contract,
     commission_value=2.50,
     calc_on_every_tick=true,
     calc_on_order_fills=true,
     process_orders_on_close=false,
     max_labels_count=500,
     max_lines_count=500,
     max_boxes_count=500)

//=========================================================
// VERSION
//=========================================================

const string VERSION = "0.1.0"

//=========================================================
// INPUT GROUPS
//=========================================================

string gSession = "Sessions"
string gHTF     = "Higher Time Frames"
string gRisk    = "Risk"
string gVisual  = "Visual"
string gFilter  = "Filters"

//=========================================================
// SESSION INPUTS
//=========================================================

showAsia   = input.bool(true, "Show Asia", group=gSession)
showLondon = input.bool(true, "Show London", group=gSession)
showNY     = input.bool(true, "Show New York", group=gSession)

asiaSession   = input.session("1700-0000", "Asia Session", group=gSession)
londonSession = input.session("0200-0500", "London Session", group=gSession)
nySession     = input.session("0830-1100", "New York Session", group=gSession)

//=========================================================
// MULTI TIMEFRAME
//=========================================================

executionTF = input.timeframe("1", "Execution TF", group=gHTF)
swingTF     = input.timeframe("5", "Swing TF", group=gHTF)
biasTF      = input.timeframe("15", "Bias TF", group=gHTF)
dailyTF     = input.timeframe("D", "Daily Liquidity", group=gHTF)

//=========================================================
// RISK
//=========================================================

riskPercent = input.float(1.0, "Risk %", step=.25, group=gRisk)

atrLength = input.int(14, "ATR Length", group=gRisk)
atrMult   = input.float(2.0, "ATR Stop", step=.25, group=gRisk)

//=========================================================
// FILTERS
//=========================================================

emaLength = input.int(50, "EMA Length", group=gFilter)

useEMA = input.bool(true, "Use EMA Filter", group=gFilter)

//=========================================================
// VISUAL
//=========================================================

showDashboard = input.bool(true, "Dashboard", group=gVisual)
showLevels    = input.bool(true, "Liquidity Levels", group=gVisual)
showSignals   = input.bool(true, "Signals", group=gVisual)

//=========================================================
// ENUMS
//=========================================================

enum Bias
    Bullish
    Bearish
    Neutral

enum TradeState
    Waiting
    LiquidityFound
    Swept
    Displacement
    MSS
    FVG
    Retracement
    Entered
    Managing

enum LiquidityType
    PDH
    PDL
    PWH
    PWL
    AsiaHigh
    AsiaLow
    LondonHigh
    LondonLow
    NYHigh
    NYLow
    SwingHigh
    SwingLow
    EqualHigh
    EqualLow

//=========================================================
// GLOBAL STATE
//=========================================================

var TradeState state = TradeState.Waiting
var Bias bias = Bias.Neutral

//=========================================================
// CORE CALCULATIONS
//=========================================================

ema = ta.ema(close, emaLength)
atr = ta.atr(atrLength)

bullTrend = close > ema
bearTrend = close < ema

plot(useEMA ? ema : na, title="EMA", color=color.orange, linewidth=2)

//=========================================================
// SESSION STATUS
//=========================================================

inAsia   = not na(time(timeframe.period, asiaSession))
inLondon = not na(time(timeframe.period, londonSession))
inNY     = not na(time(timeframe.period, nySession))

if showAsia and inAsia
    bgcolor(color.new(color.blue,92))

if showLondon and inLondon
    bgcolor(color.new(color.yellow,92))

if showNY and inNY
    bgcolor(color.new(color.green,92))

//=========================================================
// HIGHER TIMEFRAME DATA
//=========================================================

biasClose =
    request.security(
        syminfo.tickerid,
        biasTF,
        close,
        lookahead=barmerge.lookahead_off)

biasEMA =
    request.security(
        syminfo.tickerid,
        biasTF,
        ta.ema(close,50),
        lookahead=barmerge.lookahead_off)

bias :=
     biasClose > biasEMA ? Bias.Bullish :
     biasClose < biasEMA ? Bias.Bearish :
     Bias.Neutral

//=========================================================
// PREVIOUS DAY LIQUIDITY
//=========================================================

previousDayHigh =
    request.security(
        syminfo.tickerid,
        dailyTF,
        high[1],
        lookahead=barmerge.lookahead_off)

previousDayLow =
    request.security(
        syminfo.tickerid,
        dailyTF,
        low[1],
        lookahead=barmerge.lookahead_off)

plot(showLevels ? previousDayHigh : na,
     "PDH",
     color=color.lime,
     linewidth=2)

plot(showLevels ? previousDayLow : na,
     "PDL",
     color=color.red,
     linewidth=2)
//=========================================================
// LIQUIDITY ENGINE
// MODULE 02A
//=========================================================

//-------------------------
// Session Start Detection
//-------------------------

asiaStart   = inAsia and not inAsia[1]
londonStart = inLondon and not inLondon[1]
nyStart     = inNY and not inNY[1]

//-------------------------
// Session Variables
//-------------------------

var float asiaHigh = na
var float asiaLow  = na

var float londonHigh = na
var float londonLow  = na

var float nyHigh = na
var float nyLow  = na

//-------------------------
// Reset Session Ranges
//-------------------------

if asiaStart
    asiaHigh := high
    asiaLow := low

if londonStart
    londonHigh := high
    londonLow := low

if nyStart
    nyHigh := high
    nyLow := low

//-------------------------
// Track Session High/Low
//-------------------------

if inAsia
    asiaHigh := math.max(nz(asiaHigh, high), high)
    asiaLow := math.min(nz(asiaLow, low), low)

if inLondon
    londonHigh := math.max(nz(londonHigh, high), high)
    londonLow := math.min(nz(londonLow, low), low)

if inNY
    nyHigh := math.max(nz(nyHigh, high), high)
    nyLow := math.min(nz(nyLow, low), low)

//-------------------------
// Plot Liquidity
//-------------------------

plot(showLevels ? asiaHigh : na,
     "Asia High",
     color=color.aqua,
     linewidth=2)

plot(showLevels ? asiaLow : na,
     "Asia Low",
     color=color.aqua,
     linewidth=2)

plot(showLevels ? londonHigh : na,
     "London High",
     color=color.orange,
     linewidth=2)

plot(showLevels ? londonLow : na,
     "London Low",
     color=color.orange,
     linewidth=2)

plot(showLevels ? nyHigh : na,
     "NY High",
     color=color.green,
     linewidth=2)

plot(showLevels ? nyLow : na,
     "NY Low",
     color=color.green,
     linewidth=2)
